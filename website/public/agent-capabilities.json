  "newcomer_routes": [
    {
      "id": "finished_mix_alpha",
      "input": "one authorised finished song on a supported Apple-silicon Mac",
      "action": "plan and explicitly install the separate pinned alpha runtime, then use sunofriend-separate for local broad vocals and instrumental estimates; listen before any later MIDI step"
    },
    {
      "id": "have_stems",
      "input": "authorised already-separated synchronized audio parts",
      "action": "prepare supported non-WAV or mixed-format parts with source-import-folder, then use sunofriend create PROJECT --out-dir FRESH; prefer Simple / Make my song when the person operates the TUI"
    },
    {
      "id": "need_stems",
      "action": "explain DAW export, independent authorised stem services or Sunofriend's experimental local separator; broad two-stem remains default and installed SCNet is an explicit public opt-in core-four preview"
    },
    {
      "id": "worked_demo",
      "command": "sunofriend demo --out-dir FRESH",
      "action": "create copyright-safe synthetic stems and run the normal automatic MIDI/WAV/ZIP path in a fresh output directory"
    }
  ],
