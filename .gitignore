# Authorised and private-reference separation corpora can be several
# gigabytes. Track their manifests and documentation, but keep source/provider
# media and chord evidence out of Git.
stem_examples/**/*.wav
stem_examples/**/*.aif
stem_examples/**/*.aiff
stem_examples/**/*.flac
stem_examples/**/*.mp3
stem_examples/**/*.m4a
stem_examples/**/*.ogg
stem_examples/**/*.opus
stem_examples/**/*.pdf

# Local finished-song canaries are private evidence, never repository examples.
examples/*.wav
examples/*.aif
examples/*.aiff
examples/*.flac
examples/*.mp3
examples/*.m4a
examples/*.ogg
examples/*.opus

